{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["hnd1"],
  "functions": {
    "main.py": {
      "maxDuration": 300,
      "excludeFiles": "{public/**,supabase/**,tests/**,procurement_automation/tests/**,procurement_automation/shared_data/**,**/*.zip,**/*.sqlite*,**/*.dpapi,.env}"
    }
  },
  "headers": [
    {
      "source": "/workflow/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
